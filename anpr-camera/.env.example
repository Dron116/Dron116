# Скопируйте в .env и укажите пароль камеры.
# Приложение нужно запускать в той же локальной сети, что и камера.

CAMERA_HOST=192.168.83.22
CAMERA_PORT=80
CAMERA_USER=admin
CAMERA_PASSWORD=
CAMERA_RTSP_PORT=554

# Если известен точный URL снимка или RTSP — укажите его, автопоиск будет пропущен.
# CAMERA_SNAPSHOT_URL=http://192.168.83.22/ISAPI/Streaming/channels/101/picture
# CAMERA_RTSP_URL=rtsp://admin:password@192.168.83.22:554/Streaming/Channels/101

# Интервал распознавания, секунды
RECOGNIZE_INTERVAL=1.2

# Повторы одного и того же номера не пишутся в журнал чаще этого окна, секунды
DEDUP_SECONDS=20

HOST=0.0.0.0
PORT=8080
